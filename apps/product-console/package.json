{
  "name": "@outrise/product-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 127.0.0.1 --port 4317 --strictPort\"",
    "start": "node server/index.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "agent": "node cli/index.js",
    "validate": "node cli/index.js validate",
    "import:workspace": "node scripts/import-workspace.js",
    "upgrade:workbench": "node scripts/upgrade-workbench.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@milkdown/crepe": "^7.17.1",
    "@refinedev/core": "^5.0.0",
    "antd": "^5.27.0",
    "chokidar": "^4.0.3",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "vite": "^6.4.0"
  }
}
